# Copy to .env.local for local development, and set these in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.

# --- Email delivery (Resend — https://resend.com) ---
# Without this key the contact form still works but only logs enquiries
# to the server console (development fallback).
RESEND_API_KEY=

# Sender address. The default onboarding@resend.dev works immediately for
# testing; verify your own domain in Resend and update this for production.
# CONTACT_FROM_EMAIL="Rawdah Al Jazira Website <website@yourdomain.com>"

# --- Anti-spam (Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile) ---
# Optional but recommended for production. When unset, the invisible
# CAPTCHA is skipped (honeypot + rate limiting still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
